# focus windows (loop)

alt - h : yabai -m window --focus west \
          ||yabai -m window --focus stack.next \
          ||yabai -m space --focus prev \
          ||yabai -m space --focus last \
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east \
          ||yabai -m window --focus stack.next \
          ||yabai -m space --focus next \
          ||yabai -m space --focus first


# swap windows
shift + alt - h : yabai -m window --swap west
shift + alt - j : yabai -m window --swap south
shift + alt - k : yabai -m window --swap north
shift + alt - l : yabai -m window --swap east


# warp windows

ctrl + alt - h : yabai -m window --warp west
ctrl + alt - j : yabai -m window --warp south
ctrl + alt - k : yabai -m window --warp north
ctrl + alt - l : yabai -m window --warp east


# balance all the windows
shift + alt - 0 : yabai -m space --balance

# Rotate clockwise
alt - r : yabai -m space --rotate 90

shift + alt - x : yabai -m space --mirror x-axis

shift + alt - y : yabai -m space --mirror y-axis


alt - f : yabai -m window --toggle zoom-fullscreen

alt - t : yabai -m window --toggle float 

# Sticky：
alt - p : yabai -m window --toggle sticky

# Above
alt + shift - t : yabai -m window --sub-layer above

# PiP
alt + shift - p : yabai -m window --toggle pip


# Spaces

alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - q : yabai -m space --focus 4
alt - w : yabai -m space --focus 5
alt - e : yabai -m space --focus 6


# move windows to spaces

shift + alt - 1 : yabai -m window --space 1 --focus
shift + alt - 2 : yabai -m window --space 2 --focus
shift + alt - 3 : yabai -m window --space 3 --focus
shift + alt - q : yabai -m window --space 4 --focus
shift + alt - w : yabai -m window --space 5 --focus
shift + alt - e : yabai -m window --space 6 --focus


# create and destroy spaces
ctrl + alt + cmd - n : yabai -m space --create

ctrl + alt + cmd - w : yabai -m space --destroy

cmd + ctrl + alt + shift - m : yabai -m window --toggle netease
