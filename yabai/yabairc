#!/usr/bin/env sh

#
# for this to work you must configure sudo such that
# it will be able to run the command without password
#
# see this wiki page for information:
#  - https://github.com/asmvik/yabai/wiki/Installing-yabai-(latest-release)#configure-scripting-addition
#
# yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
# sudo yabai --load-sa

# load scripting addition
/usr/bin/sudo "$(command -v yabai)" --load-sa

# reload scripting addition
yabai -m signal \
  --add event=dock_did_restart \
  action="/usr/bin/sudo $(command -v yabai) --load-sa"

# start with jankyborder
# borders style=round width=6.0 hidpi=off active_color=0xff007aff inactive_color=0x00000000

# Spaces
yabai -m space 1 --label '1'
yabai -m space 2 --label '2'
yabai -m space 3 --label '3'
yabai -m space 4 --label "Q"
yabai -m space 5 --label "W"
yabai -m space 6 --label "E"

# global settings
yabai -m config \
  external_bar off:40:0 \
  menubar_opacity 1.0 \
  mouse_follows_focus off \
  focus_follows_mouse off \
  display_arrangement_order default \
  window_origin_display default \
  window_placement second_child \
  window_insertion_point focused \
  window_zoom_persist on \
  window_shadow on \
  skip_window_focus_animation off \
  window_animation_duration 0.0 \
  window_animation_easing ease_out_circ \
  window_opacity_duration 0.0 \
  active_window_opacity 1.0 \
  normal_window_opacity 0.90 \
  window_opacity off \
  insert_feedback_color 0xffd75f5f \
  split_ratio 0.50 \
  split_type auto \
  auto_balance off \
  layout bsp \
  mouse_modifier alt \
  mouse_action1 move \
  mouse_action2 resize \
  mouse_drop_action swap

GAPS_SCRIPT="$HOME/.config/yabai/set-gaps.sh"

"$HOME/.config/yabai/set-gaps.sh"

# 用于设置浮动窗口的函数
float_app() {
  yabai -m rule --add \
    label="float-$1" \
    app="$2" \
    manage=off \
    sub-layer="${3:-below}"
}

# macOS
float_app "finder" "^(Finder|访达)$"
float_app "system-settings" "^(System Settings|系统设置)$"
float_app "activity-monitor" "^(Activity Monitor|活动监视器)$"
float_app "calculator" "^(Calculator|计算器)$"
float_app "app-store" "^App Store$"
float_app "passwords" "^(Passwords|密码)$"
float_app "calendar" "^(Calendar|日历)$"
float_app "mail" "^(Mail|邮件)$"
float_app "apple-music" "^(Music|音乐)$"
float_app "photos" "^(Photos|照片)$"
float_app "books" "^(Books|图书)$"
float_app "preview" "^(Preview|预览)$"
float_app "reminders" "^(Reminders|提醒事项)$"
float_app "messages" "^(Messages|信息)$"
float_app "contacts" "^(Contacts|通讯录)$"
float_app "dictionary" "^(Dictionary|词典)$"
float_app "disk-utility" "^(Disk Utility|磁盘工具)$"

# Utilities
float_app "raycast" "^Raycast$"
float_app "tailscale" "^Tailscale$"
float_app "pomotroid" "^Pomotroid$" "above"
float_app "karabiner-elements" "^(Karabiner-Elements|Karabiner-Elements Settings)$"
float_app "karabiner-event-viewer" "^(Karabiner-EventViewer|Karabiner EventViewer)$"
float_app "linear-mouse" "^LinearMouse$"
float_app "clash-verge" "^(Clash Verge|Clash Verge Rev)$"
float_app "easydict" "^(Easydict|EasyDict)$"

# Communication
float_app "wechat" "^(WeChat|微信)$"
float_app "qq" "^QQ$"
float_app "tencent-meeting" "^(Tencent Meeting|腾讯会议)$"

# Media
float_app "spotify" "^Spotify$"
float_app "iina" "^IINA$"
float_app "bilibili" "^哔哩哔哩$"
float_app "steam" "^Steam$"
float_app "netease" "^(NetEaseMusic|NeteaseMusic|网易云音乐)$"

yabai -m rule --apply

echo "yabai configuration loaded.."
